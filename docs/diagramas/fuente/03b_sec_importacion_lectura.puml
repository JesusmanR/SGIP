@startuml
!include comun.iuml
autonumber

actor "Administrador" as A
participant "PreciosController\n<<API REST>>" as C
participant "ImportadorPrecios" as IMP
participant "LectorHojaCalculo" as LEC
participant "CargaPreciosDAO" as DAO
database "MySQL" as BD

A -> C : POST /api/v1/proveedores/{id}/cargas\n(archivo .xlsx)
activate C
C -> IMP : leer(archivo, proveedor)
activate IMP

IMP -> DAO : mapeoDe(proveedor)
DAO -> BD : SELECT ... FROM mapeos_proveedor
BD --> DAO : correspondencia de columnas
DAO --> IMP : MapeoProveedor

IMP -> LEC : leer(archivo, mapeo)
activate LEC
LEC -> LEC : traducirColumnas(fila)
LEC --> IMP : List<DetalleCarga>
deactivate LEC

IMP -> IMP : validar(carga)
note over IMP : Se rechazan registros sin referencia,\ncon costo no numérico o menor o igual a cero.

IMP -> DAO : guardar(carga, detalles)
DAO -> BD : INSERT cargas_precios\nINSERT detalle_carga_precios
DAO --> IMP : carga persistida
IMP --> C : ResultadoValidacion\n(leídos, aceptados, rechazados)
deactivate IMP
C --> A : 200 vista previa de la carga
deactivate C
@enduml
