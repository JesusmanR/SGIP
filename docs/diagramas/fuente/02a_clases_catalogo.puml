@startuml
!include comun.iuml

package "modelo — catálogo y abastecimiento" {

  class Producto {
    - id : int
    - codigo : String
    - nombre : String
    - costo : BigDecimal
    - existencia : int
    - existenciaMinima : int
    - activo : boolean
    + precioContado() : BigDecimal
    + precioCredito() : BigDecimal
    + estadoStock() : EstadoStock
    + descontar(n : int) : void
    + reponer(n : int) : void
  }

  class Categoria {
    - id : int
    - nombre : String
    - descripcion : String
  }

  class Proveedor {
    - id : int
    - razonSocial : String
    - nit : String
    - contacto : String
    - plazoDias : int
    - activo : boolean
  }

  class HistoricoCosto {
    - id : long
    - costo : BigDecimal
    - vigenteDesde : LocalDate
    - vigenteHasta : LocalDate
  }

  class ReglaMargen {
    - id : int
    - formaPago : FormaPago
    - factor : BigDecimal
    - vigenteDesde : LocalDate
    + aplicar(costo : BigDecimal) : BigDecimal
  }

  class CargaPrecios {
    - id : long
    - origen : OrigenCarga
    - fecha : LocalDateTime
    - estado : EstadoCarga
    - registrosLeidos : int
    - registrosAplicados : int
    - registrosRechazados : int
  }

  class DetalleCarga {
    - id : long
    - referenciaOrigen : String
    - costo : BigDecimal
    - aceptado : boolean
    - motivoRechazo : String
  }

  class MapeoProveedor {
    - id : int
    - campoSistema : String
    - columnaOrigen : String
    - obligatorio : boolean
  }

  enum EstadoStock {
    ACTIVO
    CRITICO
    AGOTADO
  }

  enum FormaPago {
    CONTADO
    CREDITO
  }

  enum OrigenCarga {
    ARCHIVO
    SERVICIO_WEB
  }

  enum EstadoCarga {
    CARGADA
    VALIDADA
    APLICADA
    RECHAZADA
  }
}

Categoria "1" o-- "0..*" Producto
Proveedor "1" o-- "0..*" Producto
Producto "1" *-- "0..*" HistoricoCosto
Categoria "1" -- "0..*" ReglaMargen
Proveedor "1" -- "0..*" ReglaMargen
Proveedor "1" *-- "0..*" CargaPrecios
Proveedor "1" *-- "0..*" MapeoProveedor
CargaPrecios "1" *-- "1..*" DetalleCarga
DetalleCarga "0..*" ..> "1" Producto : actualiza

Producto ..> EstadoStock
ReglaMargen ..> FormaPago
CargaPrecios ..> OrigenCarga
CargaPrecios ..> EstadoCarga

@enduml
