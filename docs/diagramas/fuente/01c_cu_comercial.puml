@startuml
!include comun.iuml
left to right direction

actor "Administrador" as ADM
actor "Vendedor" as VEN
actor "Proveedor tecnológico\nde facturación" as PTF

rectangle "SGIP — Comercial, inventario y reportes" {
  usecase "CU-13\nGenerar cotización" as CU13
  usecase "CU-14\nConvertir cotización en pedido" as CU14
  usecase "CU-15\nRegistrar venta" as CU15
  usecase "CU-16\nEmitir factura electrónica" as CU16
  usecase "CU-17\nRegistrar ingreso de mercancía" as CU17
  usecase "CU-18\nConsultar reportes" as CU18
  usecase "Registrar movimiento\nde inventario" as CUM
}

VEN --> CU13
VEN --> CU14
VEN --> CU15
ADM --> CU15
ADM --> CU16
ADM --> CU17
ADM --> CU18
CU14 ..> CU13 : <<extend>>
CU15 ..> CU16 : <<include>>
CU15 ..> CUM : <<include>>
CU17 ..> CUM : <<include>>
CU16 ..> PTF : <<transmite>>
@enduml
