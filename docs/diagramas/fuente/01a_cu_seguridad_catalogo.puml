@startuml
!pragma layout smetana
!include comun.iuml
left to right direction

actor "Super administrador\nde plataforma (BSP)" as SUP
actor "Administrador\nde empresa" as ADM
actor "Vendedor\no cajero" as VEN
actor "Cliente" as CLI

rectangle "SGIP — Plataforma, seguridad y catálogo" {
  usecase "CU-01\nIniciar sesión" as CU01
  usecase "CU-02\nCerrar sesión" as CU02
  usecase "CU-03\nRegistrar una empresa" as CU03
  usecase "CU-04\nActivar o desactivar\nuna empresa" as CU04
  usecase "CU-05\nAdministrar suscripción\ny periodo de prueba" as CU05
  usecase "CU-06\nMantener los datos\ntributarios nacionales" as CU06
  usecase "CU-07\nGestionar los usuarios\nde la empresa" as CU07
  usecase "CU-08\nRegistrar producto" as CU08
  usecase "CU-09\nEditar o desactivar\nproducto" as CU09
  usecase "CU-10\nAdministrar categorías" as CU10
  usecase "CU-11\nConsultar catálogo" as CU11
  usecase "CU-12\nConsultar producto\npor código" as CU12
}

SUP --> CU01
SUP --> CU02
SUP --> CU03
SUP --> CU04
SUP --> CU05
SUP --> CU06

ADM --> CU01
ADM --> CU02
ADM --> CU07
ADM --> CU08
ADM --> CU09
ADM --> CU10
ADM --> CU11

VEN --> CU01
VEN --> CU11
VEN --> CU12

CLI --> CU01
CLI --> CU11
CLI --> CU12

note bottom of CU04
  Una empresa desactivada conserva
  acceso de solo consulta: lectura sí,
  escritura no. Nada se borra.
end note

note top of CU06
  La plataforma mantiene lo que es igual
  para todas las empresas: UVT, tarifas
  y umbrales de exclusión. No entra en
  los datos operativos de ningún negocio.
end note
@enduml
