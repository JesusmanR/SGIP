@startuml
!include comun.iuml
autonumber

actor "Usuario" as U
participant "AuthController\n<<API REST>>" as C
participant "ServicioAutenticacion" as SA
participant "UsuarioDAO" as DAO
participant "Seguridad\n<<utilidad>>" as SEG
database "MySQL" as BD

U -> C : POST /api/v1/auth/login\n{correo, clave}
activate C
C -> SA : autenticar(correo, clave)
activate SA

SA -> DAO : buscarPorCorreo(correo)
activate DAO
DAO -> BD : SELECT ... FROM usuarios
BD --> DAO : fila o vacío
DAO --> SA : Usuario o null
deactivate DAO

alt usuario inexistente o bloqueado
  SA -> DAO : registrarAcceso(correo, false)
  DAO -> BD : INSERT INTO auditoria_accesos
  SA --> C : AutenticacionException
  C --> U : 401 Credenciales inválidas
else usuario encontrado
  SA -> SEG : verificar(clave, claveHash)
  activate SEG
  SEG --> SA : resultado booleano
  deactivate SEG

  alt clave incorrecta
    SA -> SA : incrementarIntentos(correo)
    SA -> DAO : registrarAcceso(correo, false)
    DAO -> BD : INSERT INTO auditoria_accesos
    opt intentos >= 5
      SA -> DAO : bloquear(correo)
      DAO -> BD : UPDATE usuarios SET bloqueado = 1
    end
    SA --> C : AutenticacionException
    C --> U : 401 Credenciales inválidas
  else clave correcta
    SA -> SA : reiniciarIntentos(correo)
    SA -> DAO : registrarAcceso(correo, true)
    DAO -> BD : INSERT INTO auditoria_accesos
    SA --> C : Sesion(token, rol)
    deactivate SA
    C --> U : 200 {token, rol, expiracion}
    deactivate C
  end
end

note over C, SA
  El mensaje de error no distingue entre correo
  inexistente y clave incorrecta, para impedir
  la enumeración de usuarios válidos.
end note
@enduml
