@startuml
!include comun.iuml
hide circle
skinparam linetype ortho

entity "clientes" as cli {
  * cliente_id : INT <<PK>>
  --
  * empresa_id : INT <<FK>>
  usuario_id : INT <<FK>>
  * tipo_documento : ENUM
  * nit : VARCHAR(20)
  * razon_social : VARCHAR(160)
  autorizacion_datos : DATETIME
}

entity "medios_pago" as mp {
  * medio_id : INT <<PK>>
  --
  * empresa_id : INT <<FK>>
  * nombre : VARCHAR(60)
  * tipo : ENUM(EFECTIVO, TARJETA, TRANSFERENCIA, CREDITO)
  activo : BOOL
}

entity "cotizaciones" as cot {
  * cotizacion_id : BIGINT <<PK>>
  --
  * empresa_id : INT <<FK>>
  * cliente_id : INT <<FK>>
  * usuario_id : INT <<FK>>
  * consecutivo : VARCHAR(20)
  * fecha : DATETIME
  * vence : DATE
  * estado : ENUM(VIGENTE, VENCIDA, CONVERTIDA)
}

entity "cotizacion_items" as coti {
  * item_id : BIGINT <<PK>>
  --
  * cotizacion_id : BIGINT <<FK>>
  * producto_id : INT <<FK>>
  * cantidad : INT
  * precio_unitario : DECIMAL(14,2)
}

entity "ventas" as ven {
  * venta_id : BIGINT <<PK>>
  --
  * empresa_id : INT <<FK>>
  * cliente_id : INT <<FK>>
  * usuario_id : INT <<FK>>
  * medio_id : INT <<FK>>
  cotizacion_id : BIGINT <<FK>>
  cierre_id : BIGINT <<FK>>
  * consecutivo : VARCHAR(20)
  * fecha : DATETIME
  * estado_pago : ENUM(PENDIENTE, PAGADA, ANULADA)
  sin_existencia : BOOL
  * total : DECIMAL(14,2) <<generada>>
}

entity "venta_items" as veni {
  * item_id : BIGINT <<PK>>
  --
  * venta_id : BIGINT <<FK>>
  * producto_id : INT <<FK>>
  * cantidad : INT
  * precio_unitario : DECIMAL(14,2)
  descuento : DECIMAL(14,2)
}

entity "cierres_caja" as cc {
  * cierre_id : BIGINT <<PK>>
  --
  * empresa_id : INT <<FK>>
  * usuario_id : INT <<FK>>
  * apertura : DATETIME
  cierre : DATETIME
  * esperado : DECIMAL(14,2)
  contado : DECIMAL(14,2)
  diferencia : DECIMAL(14,2) <<generada>>
}

entity "facturas_electronicas" as fe {
  * factura_id : BIGINT <<PK>>
  --
  * venta_id : BIGINT <<FK>>
  cufe : VARCHAR(96) <<UQ>>
  * estado : ENUM(ENVIADA, VALIDADA, RECHAZADA)
  motivo_rechazo : VARCHAR(200)
}

cli ||--o{ cot
cli ||--o{ ven
cot ||--o{ coti
cot |o--o| ven
ven ||--o{ veni
mp ||--o{ ven
cc ||--o{ ven
ven ||--o| fe

note bottom of cc
  El cierre agrupa las ventas del turno.
  La diferencia entre lo esperado y lo
  contado se calcula, no se digita.
end note
@enduml
