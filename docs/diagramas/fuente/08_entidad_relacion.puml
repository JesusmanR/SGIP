@startuml
!include comun.iuml
hide circle
skinparam defaultFontSize 20
hide empty members
skinparam nodesep 18
skinparam ranksep 45

  entity "empresas" as emp {
    * empresa_id
  }
  entity "suscripciones" as sus {
    * suscripcion_id
  }
  entity "roles" as rol {
    * rol_id
  }
  entity "usuarios" as usu {
    * usuario_id
  }
  entity "sesiones" as ses {
    * sesion_id
  }
  entity "auditoria_accesos" as aud {
    * acceso_id
  }
  entity "categorias" as cat {
    * categoria_id
  }
  entity "productos" as pro {
    * producto_id
  }
  entity "historico_costos" as hco {
    * historico_id
  }
  entity "proveedores" as prv {
    * proveedor_id
  }
  entity "producto_proveedor" as ppr {
    * producto_proveedor_id
  }
  entity "ordenes_compra" as ord {
    * orden_id
  }
  entity "orden_compra_items" as ori {
    * item_id
  }
  entity "recepciones" as rec {
    * recepcion_id
  }
  entity "mapeos_proveedor" as map {
    * mapeo_id
  }
  entity "cargas_precios" as car {
    * carga_id
  }
  entity "detalle_carga_precios" as dca {
    * detalle_id
  }
  entity "movimientos_inventario" as mov {
    * movimiento_id
  }
  entity "clientes" as cliE {
    * cliente_id
  }
  entity "medios_pago" as mpa {
    * medio_id
  }
  entity "cotizaciones" as cot {
    * cotizacion_id
  }
  entity "cotizacion_items" as cti {
    * item_id
  }
  entity "ventas" as ven {
    * venta_id
  }
  entity "venta_items" as vti {
    * item_id
  }
  entity "cierres_caja" as cie {
    * cierre_id
  }
  entity "facturas_electronicas" as fac {
    * factura_id
  }
  entity "parametros" as par {
    * parametro_id
  }
  entity "reglas_margen" as rma {
    * regla_id
  }
  entity "reglas_envio" as ren {
    * regla_envio_id
  }
  entity "reglas_iva" as riv {
    * regla_iva_id
  }
  entity "uvt_anual" as uvt {
    * anio
  }
  entity "calendario_habil" as cal {
    * fecha
  }
  entity "cola_sincronizacion" as col {
    * operacion_id
  }
  entity "descuadres_existencia" as des {
    * descuadre_id
  }

emp ||--|| sus
emp ||--o{ usu
rol ||--o{ usu
usu ||--o{ ses
usu ||--o{ aud

emp ||--o{ cat
cat ||--o{ pro
pro ||--o{ hco
emp ||--o{ prv
prv ||--o{ ppr
pro ||--o{ ppr
prv ||--o{ ord
ord ||--o{ ori
pro ||--o{ ori
ord ||--o{ rec
rec ||--o{ mov
pro ||--o{ mov

prv ||--o{ map
prv ||--o{ car
car ||--o{ dca
pro ||--o{ dca

emp ||--o{ cliE
emp ||--o{ mpa
cliE ||--o{ cot
cot ||--o{ cti
pro ||--o{ cti
cliE ||--o{ ven
cot |o--o| ven
ven ||--o{ vti
pro ||--o{ vti
mpa ||--o{ ven
cie ||--o{ ven
ven ||--o| fac

emp ||--o{ par
emp ||--o{ rma
emp ||--o{ ren
cat ||--o{ rma
uvt ||..o{ riv
cat ||--o{ riv

emp ||--o{ col
col ||--o{ des
pro ||--o{ des
@enduml
