@startuml
!include comun.iuml

package "logica — inventario, precios e importación" {

  class Inventario {
    + registrar(p : Producto) : void
    + buscarPorCodigo(codigo : String) : Producto
    + listar(f : Filtro) : Pagina<Producto>
    + descontar(id : int, n : int) : Movimiento
    + reponer(id : int, n : int) : Movimiento
    + criticos() : List<Producto>
  }

  class MotorPrecios {
    + reglaAplicable(p : Producto, fp : FormaPago) : ReglaMargen
    + calcular(p : Producto, fp : FormaPago) : BigDecimal
    + recalcularAfectados(c : CargaPrecios) : int
  }

  class ImportadorPrecios {
    + leer(archivo : File, prov : Proveedor) : CargaPrecios
    + consultarServicio(prov : Proveedor) : CargaPrecios
    + validar(c : CargaPrecios) : ResultadoValidacion
    + aplicar(c : CargaPrecios) : int
  }

  interface LectorListaPrecios {
    + leer(origen : Object, prov : Proveedor) : List<DetalleCarga>
  }

  class LectorHojaCalculo
  class LectorServicioWeb
}

LectorListaPrecios <|.. LectorHojaCalculo
LectorListaPrecios <|.. LectorServicioWeb
ImportadorPrecios --> LectorListaPrecios : usa
ImportadorPrecios --> MotorPrecios : dispara recálculo
MotorPrecios --> Inventario

note bottom of LectorListaPrecios
  La interfaz aísla el formato de origen.
  Incorporar un proveedor con estructura
  distinta añade una implementación y no
  modifica el importador.
end note
@enduml
