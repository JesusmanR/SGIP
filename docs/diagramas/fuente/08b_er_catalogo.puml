@startuml
!include comun.iuml
hide circle
skinparam linetype ortho

entity "categorias" as cat {
  * categoria_id : INT <<PK>>
  --
  * empresa_id : INT <<FK>>
  * nombre : VARCHAR(80)
  activa : BOOL
}

entity "productos" as prod {
  * producto_id : INT <<PK>>
  --
  * empresa_id : INT <<FK>>
  * categoria_id : INT <<FK>>
  * sku : VARCHAR(40) <<UQ empresa>>
  * nombre : VARCHAR(160)
  * presentacion : VARCHAR(60)
  codigo_barras : VARCHAR(60)
  * costo : DECIMAL(14,2)
  * existencia : INT
  * existencia_minima : INT
  estado_stock : ENUM <<generada>>
}

entity "proveedores" as prov {
  * proveedor_id : INT <<PK>>
  --
  * empresa_id : INT <<FK>>
  * nit : VARCHAR(20)
  * razon_social : VARCHAR(160)
  plazo_dias : INT
  origen_lista : ENUM
}

entity "producto_proveedor" as pp {
  * producto_proveedor_id : INT <<PK>>
  --
  * producto_id : INT <<FK>>
  * proveedor_id : INT <<FK>>
  * referencia : VARCHAR(60)
  * costo : DECIMAL(14,2)
  preferente : BOOL
}

entity "ordenes_compra" as oc {
  * orden_id : BIGINT <<PK>>
  --
  * empresa_id : INT <<FK>>
  * proveedor_id : INT <<FK>>
  * consecutivo : VARCHAR(20)
  * fecha : DATETIME
  * estado : ENUM(ABIERTA, PARCIAL, RECIBIDA, ANULADA)
}

entity "orden_compra_items" as oci {
  * item_id : BIGINT <<PK>>
  --
  * orden_id : BIGINT <<FK>>
  * producto_id : INT <<FK>>
  * cantidad : INT
  * costo_unitario : DECIMAL(14,2)
  cantidad_recibida : INT
}

entity "recepciones" as rec {
  * recepcion_id : BIGINT <<PK>>
  --
  * orden_id : BIGINT <<FK>>
  * usuario_id : INT <<FK>>
  * fecha : DATETIME
  observacion : VARCHAR(200)
}

entity "movimientos_inventario" as mov {
  * movimiento_id : BIGINT <<PK>>
  --
  * empresa_id : INT <<FK>>
  * producto_id : INT <<FK>>
  * usuario_id : INT <<FK>>
  recepcion_id : BIGINT <<FK>>
  * tipo : ENUM(INICIAL, INGRESO, EGRESO, AJUSTE)
  * cantidad : INT
  * anterior : INT
  * posterior : INT
  motivo : VARCHAR(200)
  * fecha : DATETIME
}

entity "historico_costos" as hc {
  * historico_id : BIGINT <<PK>>
  --
  * producto_id : INT <<FK>>
  * costo : DECIMAL(14,2)
  * vigente_desde : DATETIME
}

cat ||--o{ prod
prov ||--o{ pp
prod ||--o{ pp
prov ||--o{ oc
oc ||--o{ oci
prod ||--o{ oci
oc ||--o{ rec
rec ||--o{ mov
prod ||--o{ mov
prod ||--o{ hc

note right of pp
  Resuelve el requisito RF-21: una misma
  referencia la venden varios proveedores,
  cada uno con su código y su costo, sin
  duplicar el producto en el catálogo.
end note
@enduml
