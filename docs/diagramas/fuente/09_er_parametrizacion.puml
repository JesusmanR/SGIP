@startuml
!include comun.iuml
hide circle
skinparam linetype ortho
skinparam nodesep 16
skinparam ranksep 40

package "Parámetros nacionales · los mantiene la plataforma" {
  entity "uvt_anual" as uvt {
    * anio : INT <<PK>>
    --
    * valor : DECIMAL(12,2)
    resolucion : VARCHAR(80)
  }
  entity "reglas_iva" as iva {
    * regla_iva_id : INT <<PK>>
    --
    categoria_id : INT <<FK>>
    * tratamiento : ENUM
    umbral_uvt : DECIMAL(8,2)
    * tarifa : DECIMAL(5,4)
    * vigente_desde : DATE
  }
  entity "calendario_habil" as cal {
    * fecha : DATE <<PK>>
    --
    * tipo : ENUM(FESTIVO, HABIL)
    descripcion : VARCHAR(80)
  }
}

package "Parámetros de cada empresa" {
  entity "parametros" as par {
    * parametro_id : INT <<PK>>
    --
    * empresa_id : INT <<FK>>
    * clave : VARCHAR(80)
    * valor : VARCHAR(200)
    * tipo_dato : ENUM
    * vigente_desde : DATE
  }
  entity "reglas_margen" as rm {
    * regla_id : INT <<PK>>
    --
    * empresa_id : INT <<FK>>
    categoria_id : INT <<FK>>
    proveedor_id : INT <<FK>>
    * forma_calculo : ENUM(SOBRE_COSTO, SOBRE_PRECIO)
    * factor : DECIMAL(6,4)
    * vigente_desde : DATE
  }
  entity "reglas_envio" as re {
    * regla_envio_id : INT <<PK>>
    --
    * empresa_id : INT <<FK>>
    * umbral : DECIMAL(14,2)
    * base : ENUM(SUBTOTAL, TOTAL)
    * costo_envio : DECIMAL(14,2)
  }
}

package "Sincronización" {
  entity "cola_sincronizacion" as cs {
    * operacion_id : BIGINT <<PK>>
    --
    * empresa_id : INT <<FK>>
    * usuario_id : INT <<FK>>
    * clave_idempotencia : CHAR(36) <<UQ>>
    * tipo : ENUM(VENTA, CIERRE, AJUSTE)
    * carga : JSON
    * registrada_dispositivo : DATETIME
    * recibida_servidor : DATETIME
    * estado : ENUM(PENDIENTE, APLICADA, RECHAZADA)
  }
  entity "descuadres_existencia" as de {
    * descuadre_id : BIGINT <<PK>>
    --
    * operacion_id : BIGINT <<FK>>
    * producto_id : INT <<FK>>
    * solicitada : INT
    * disponible : INT
    * resultante : INT
    resuelto : BOOL
  }
}

uvt -[hidden]down- par
par -[hidden]down- cs

uvt ||..o{ iva
cs ||--o{ de

note bottom of cs
  La clave de idempotencia la genera el
  dispositivo. Un reenvío de la misma
  operación no duplica la venta.
end note

note bottom of rm
  forma_calculo distingue el recargo
  sobre el costo del margen sobre el
  precio de venta: un mismo porcentaje
  da resultados distintos.
end note
@enduml
