@startuml
!include comun.iuml
autonumber

actor "Administrador" as A
participant "PreciosController\n<<API REST>>" as C
participant "ImportadorPrecios" as IMP
participant "MotorPrecios" as MP
participant "CargaPreciosDAO" as DAO
database "MySQL" as BD

A -> C : POST /api/v1/cargas/{id}/aplicar
activate C
C -> IMP : aplicar(carga)
activate IMP
IMP -> DAO : actualizarCostos(detalles aceptados)
DAO -> BD : UPDATE productos SET costo\nINSERT historico_costos
IMP -> MP : recalcularAfectados(carga)
activate MP
MP -> DAO : reglasVigentes()
DAO -> BD : SELECT ... FROM reglas_margen
MP -> BD : columnas generadas recalculan\nprecio_contado y precio_credito
MP --> IMP : cantidad de productos afectados
deactivate MP
IMP -> DAO : marcarEstado(carga, APLICADA)
DAO -> BD : UPDATE cargas_precios
IMP --> C : cantidad aplicada
deactivate IMP
C --> A : 200 carga aplicada
deactivate C
@enduml
