@startuml
!include comun.iuml

state "Registrado" as REG
state "Activo" as ACT
state "Crítico" as CRI
state "Agotado" as AGO
state "Desactivado" as DES

[*] --> REG : registrar producto
REG --> ACT : existencia > mínimo
REG --> CRI : existencia <= mínimo
REG --> AGO : existencia = 0

ACT --> CRI : venta deja\nexistencia <= mínimo
CRI --> AGO : venta deja\nexistencia = 0
CRI --> ACT : ingreso deja\nexistencia > mínimo
AGO --> CRI : ingreso deja\nexistencia <= mínimo
AGO --> ACT : ingreso deja\nexistencia > mínimo

ACT --> DES : desactivar
CRI --> DES : desactivar
AGO --> DES : desactivar
DES --> ACT : reactivar
DES --> [*] : depuración de catálogo

note right of CRI
  El umbral mínimo es configurable
  por producto. El sistema emite
  notificación al entrar en este estado.
end note

note bottom of DES
  La desactivación conserva el historial
  de movimientos y de costos. El producto
  deja de aparecer en el catálogo.
end note
@enduml
