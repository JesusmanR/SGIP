@startuml
!include comun.iuml

node "Dispositivo Android\ndel vendedor" as DISP {
  artifact "sgip-movil.apk" as APK
}

node "Estación de trabajo\nadministrativa" as PC {
  artifact "sgip-escritorio.jar" as JAR
}

node "Servidor de aplicaciones" as SRV {
  artifact "sgip-backend.jar" as BACK
  artifact "openapi.yaml" as SPEC
}

node "Servidor de base de datos" as DBS {
  database "MySQL 8.0\nesquema sgip" as BD
}

cloud "Internet" as NET

node "Plataforma del proveedor\ntecnológico de facturación" as PTF {
  artifact "API de facturación" as APIFE
}

node "Portales y servicios\nde proveedores" as PROV {
  artifact "Listas de precios" as LP
}

DISP -down- NET : HTTPS
NET -down- SRV : HTTPS / TLS 1.2+
PC -right- SRV : HTTPS red interna
SRV -down- DBS : JDBC sobre TLS
SRV -right- PTF : HTTPS
SRV -right- PROV : HTTPS

note bottom of DBS
  Respaldo diario automatizado
  con retención de treinta días.
end note
@enduml
