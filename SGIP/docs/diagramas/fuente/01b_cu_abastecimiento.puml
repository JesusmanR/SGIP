@startuml
!include comun.iuml
left to right direction

actor "Administrador" as ADM
actor "Servicio de\nproveedor" as SPR

rectangle "SGIP — Abastecimiento y precios" {
  usecase "CU-09\nGestionar proveedores" as CU09
  usecase "CU-10\nConfigurar correspondencia\nde columnas" as CU10
  usecase "CU-11\nImportar lista de precios" as CU11
  usecase "CU-12\nConfigurar reglas de margen" as CU12
  usecase "Validar registros\nde la carga" as CUV
  usecase "Recalcular precios\nde venta" as CUR
}

ADM --> CU09
ADM --> CU10
ADM --> CU11
ADM --> CU12
CU11 ..> CUV : <<include>>
CU11 ..> CUR : <<include>>
CUR ..> CU12 : <<include>>
CU11 ..> CU10 : <<include>>
CU11 ..> SPR : <<consulta>>
@enduml
