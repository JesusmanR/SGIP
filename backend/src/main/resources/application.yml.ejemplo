# Copiar como application.yml y completar con valores locales.
# application.yml está en .gitignore: nunca se versiona.

spring:
  datasource:
    url: jdbc:mysql://${SGIP_BD_HOST:localhost}:${SGIP_BD_PUERTO:3306}/sgip?useSSL=true&serverTimezone=America/Bogota
    username: ${SGIP_BD_USUARIO}
    password: ${SGIP_BD_CLAVE}
  # Los límites de subida NO están aquí: los fija ConfiguracionSubidas a
  # partir del tope de AlmacenArchivos. Estaban en este archivo, que no
  # se versiona, y eso tenía dos consecuencias malas: cambiarlos no
  # llegaba a las demás máquinas con un «git pull», y eran tres números
  # que había que mantener de acuerdo a mano. Cualquier
  # spring.servlet.multipart.* que quede en un application.yml viejo ya
  # no tiene efecto.
  jpa:
    hibernate:
      ddl-auto: validate      # El esquema lo gobiernan las migraciones, no Hibernate.
    open-in-view: false

sgip:
  seguridad:
    # La sesión vive en la tabla sesiones y su token es azar puro, no un
    # JWT firmado: no hay ningún secreto que configurar. El valor es la
    # expiración por inactividad, que cada petición renueva.
    sesion-minutos: 30
    intentos-maximos: 5
  archivos:
    # Carpeta donde se guardan las imágenes. Relativa a donde se arranca
    # la aplicación, o absoluta si se prefiere fuera del proyecto.
    raiz: ${SGIP_ARCHIVOS_RAIZ:archivos}
    # bytes-maximos ya no se configura: el tope está en
    # AlmacenArchivos.BYTES_MAXIMOS, del que se derivan los de multipart.
    # Lo que se guarda no mide eso de todos modos, porque la imagen se
    # normaliza antes de tocar el disco.
  facturacion:
    proveedor-url: ${SGIP_FE_URL:}
    proveedor-token: ${SGIP_FE_TOKEN:}

logging:
  level:
    root: INFO
    co.com.bspstore.sgip: DEBUG
