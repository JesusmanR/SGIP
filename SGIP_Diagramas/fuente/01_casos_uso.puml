@startuml
!include comun.iuml
left to right direction

actor "Administrador" as ADM
actor "Vendedor" as VEN
actor "Cliente" as CLI
actor "Servicio de\nproveedor" as SPR
actor "Proveedor tecnológico\nde facturación" as PTF

rectangle "SGIP — Sistema de Gestión de Inventario de Productos" {

  package "Seguridad" {
    usecase "CU-01\nIniciar sesión" as CU01
    usecase "CU-02\nCerrar sesión" as CU02
    usecase "CU-03\nGestionar usuarios\ny roles" as CU03
  }

  package "Catálogo" {
    usecase "CU-04\nRegistrar producto" as CU04
    usecase "CU-05\nEditar producto" as CU05
    usecase "CU-06\nDesactivar producto" as CU06
    usecase "CU-07\nConsultar catálogo" as CU07
    usecase "CU-08\nConsultar producto\npor código" as CU08
  }

  package "Abastecimiento y precios" {
    usecase "CU-09\nGestionar proveedores" as CU09
    usecase "CU-10\nConfigurar\ncorrespondencia\nde columnas" as CU10
    usecase "CU-11\nImportar lista\nde precios" as CU11
    usecase "CU-12\nConfigurar reglas\nde margen" as CU12
  }

  package "Comercial" {
    usecase "CU-13\nGenerar cotización" as CU13
    usecase "CU-14\nConvertir cotización\nen pedido" as CU14
    usecase "CU-15\nRegistrar venta" as CU15
    usecase "CU-16\nEmitir factura\nelectrónica" as CU16
  }

  package "Inventario y reportes" {
    usecase "CU-17\nRegistrar ingreso\nde mercancía" as CU17
    usecase "CU-18\nConsultar reportes" as CU18
  }
}

ADM --> CU01
ADM --> CU02
ADM --> CU03
ADM --> CU04
ADM --> CU05
ADM --> CU06
ADM --> CU09
ADM --> CU10
ADM --> CU11
ADM --> CU12
ADM --> CU15
ADM --> CU16
ADM --> CU17
ADM --> CU18

VEN --> CU01
VEN --> CU02
VEN --> CU07
VEN --> CU08
VEN --> CU13
VEN --> CU14
VEN --> CU15

CLI --> CU01
CLI --> CU02
CLI --> CU07
CLI --> CU08

CU11 ..> SPR : <<consulta>>
CU16 ..> PTF : <<transmite>>

CU11 ..> CU10 : <<include>>
CU11 ..> CU12 : <<include>>
CU13 ..> CU07 : <<include>>
CU15 ..> CU16 : <<include>>
CU14 ..> CU13 : <<extend>>
CU08 ..> CU07 : <<extend>>

@enduml
