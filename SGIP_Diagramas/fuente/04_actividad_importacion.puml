@startuml
!include comun.iuml

|Administrador|
start
:Seleccionar proveedor;
:Cargar archivo de lista de precios
o solicitar consulta al servicio web;

|Sistema|
if (¿existe configuración de columnas
para el proveedor?) then (no)
  |Administrador|
  :Definir correspondencia entre
  columnas de origen y campos;
  |Sistema|
  :Guardar configuración del proveedor;
else (sí)
endif

:Leer registros del origen;
:Registrar encabezado de carga
en estado CARGADA;

repeat :Tomar siguiente registro;
  if (¿referencia existe en el catálogo?) then (no)
    :Marcar registro como rechazado
    con motivo "referencia inexistente";
  else (sí)
    if (¿costo numérico y mayor que cero?) then (no)
      :Marcar registro como rechazado
      con motivo "costo inválido";
    else (sí)
      :Marcar registro como aceptado;
    endif
  endif
repeat while (¿quedan registros?) is (sí) not (no)

:Registrar totales de leídos,
aceptados y rechazados;
:Cambiar estado a VALIDADA;

|Administrador|
:Revisar vista previa de la carga;
if (¿aprueba la aplicación?) then (sí)
  |Sistema|
  :Actualizar costo de los productos
  con registros aceptados;
  :Registrar histórico de costos
  con fecha de vigencia;
  :Aplicar reglas de margen vigentes;
  :Recalcular precio de contado
  y precio de crédito;
  :Cambiar estado a APLICADA;
  :Notificar productos que quedaron
  en existencia crítica;
  |Administrador|
  :Consultar resumen de la aplicación;
  stop
else (no)
  |Sistema|
  :Cambiar estado a RECHAZADA;
  stop
endif
@enduml
